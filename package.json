{
	"name": "@moleculer/mcp-server",
	"version": "0.2.0",
	"description": "Moleculer MCP Server",
	"type": "module",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"files": [
		"README.md",
		"LICENSE",
		"dist"
	],
	"scripts": {
		"dev": "cross-env DANGEROUSLY_OMIT_AUTH=true nodemon --inspect examples/index.ts",
		"start": "tsx examples/index.ts",
		"inspect": "cross-env DANGEROUSLY_OMIT_AUTH=true mcp-inspector",
		"client": "tsx examples/client/index.ts",
		"ci": "vitest --watch",
		"test": "vitest --run --coverage",
		"deps": "ncu -i && npm audit fix",
		"ci-update-deps": "ncu -u",
		"lint": "eslint --ext=.ts src examples test",
		"lint:fix": "eslint --ext=.ts src examples test --fix",
		"check": "tsc",
		"check:src": "tsc -p tsconfig.build.json --noEmit",
		"prebuild": "rimraf dist",
		"build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
		"postbuild": "node scripts/postbuild.mjs",
		"prepare": "npm run build",
		"version": "node scripts/sync-version.mjs && git add src/version.ts"
	},
	"keywords": [
		"mcp-server",
		"moleculer",
		"microservice"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/moleculerjs/mcp-server.git"
	},
	"author": "MoleculerJS",
	"license": "MIT",
	"peerDependencies": {
		"moleculer": "^0.14.12 || ^0.15.0",
		"moleculer-web": "^0.10.0 || ^0.11.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"lodash": "^4.18.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/inspector": "^1.0.2",
		"@moleculer/database": "^0.4.1",
		"@seald-io/nedb": "^4.1.2",
		"@types/lodash": "^4.17.25",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^5.0.3",
		"cross-env": "^10.1.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^17.13.0",
		"mcp-remote": "0.14.3",
		"moleculer": "^0.15.2",
		"moleculer-repl": "^0.8.0",
		"moleculer-web": "^0.11.0",
		"nodemon": "^3.1.14",
		"npm-check-updates": "^22.2.9",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"zod-to-json-schema": "^3.25.2"
	},
	"engines": {
		"node": ">= 22.12.0"
	}
}
